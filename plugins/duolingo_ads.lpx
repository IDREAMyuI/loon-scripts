[Script]
http-response ^https:\/\/ios-api-2\.duolingo\.cn\/2023-05-23\/messaging\/get-messages\/?(?:\?|$) script-path=https://raw.githubusercontent.com/IDREAMyuI/loon-scripts/agent/duolingo-post-lesson-ads/scripts/duolingo_disable_ads.js,requires-body=true,binary-body-mode=false,timeout=10,tag=多邻国过滤课后插屏

http-response ^https:\/\/ios-api-2\.duolingo\.cn\/(?:2026-03-09\/plus-promotions\/get-fallback-ads|2026-03-06\/plus-promotions\/get-ad-urls)\/?(?:\?|$) script-path=https://raw.githubusercontent.com/IDREAMyuI/loon-scripts/agent/duolingo-post-lesson-ads/scripts/duolingo_disable_ads.js,requires-body=true,binary-body-mode=false,timeout=10,tag=多邻国过滤自有视频推广

[Mitm]
hostname=ios-api-2.duolingo.cn
