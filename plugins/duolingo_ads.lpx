#!name=测试版·多邻国课后插屏净化
#!desc=v6 测试：保留过滤范围，压缩阶段日志并记录正文类型和长度摘要；待实机验证
#!author=IDREAMyuI
#!loon_version=3.5.0(975)
# Updated: 2026-09-18
# 独立分支测试版：先停用正式多邻国插件，避免重复执行。
# 新增路径仅改写自动课后广告决策，不修改奖励、会员、课程结算；不拦截第三方 SDK。

[Script]
http-response ^https:\/\/ios-api-2\.duolingo\.cn\/2023-05-23\/messaging\/get-messages\/?(?:\?|$) script-path=https://raw.githubusercontent.com/IDREAMyuI/loon-scripts/agent/duolingo-session-end-decisions/scripts/duolingo_disable_ads.js,requires-body=true,binary-body-mode=false,timeout=10,tag=多邻国过滤课后插屏

http-response ^https:\/\/ios-api-2\.duolingo\.cn\/(?:2026-03-09\/plus-promotions\/get-fallback-ads|2026-03-06\/plus-promotions\/get-ad-urls)\/?(?:\?|$) script-path=https://raw.githubusercontent.com/IDREAMyuI/loon-scripts/agent/duolingo-session-end-decisions/scripts/duolingo_disable_ads.js,requires-body=true,binary-body-mode=false,timeout=10,tag=多邻国过滤自有视频推广

http-response ^https:\/\/ios-api-2\.duolingo\.cn\/2021-05-05\/plus-promotions\/decisions\/[0-9]+\/?(?:\?|$) script-path=https://raw.githubusercontent.com/IDREAMyuI/loon-scripts/agent/duolingo-session-end-decisions/scripts/duolingo_disable_ads.js,requires-body=true,binary-body-mode=false,timeout=10,tag=多邻国过滤旧版课后广告决策
http-response ^https:\/\/ios-api-2\.duolingo\.cn\/plus-promotions\/ml-predictions\/centralized-decision\/?(?:\?|$) script-path=https://raw.githubusercontent.com/IDREAMyuI/loon-scripts/agent/duolingo-session-end-decisions/scripts/duolingo_disable_ads.js,requires-body=true,binary-body-mode=false,timeout=10,tag=多邻国过滤集中课后视频决策

[Mitm]
hostname=ios-api-2.duolingo.cn
